      "bytes": 42480,
      "codec": "mp3",
      "sample_rate": 24000,
      "channels": 1
    },
    {
      "role": "boss",
      "text": "훈련하면서 별도 예산이나 준비할 사항은 있었어요?",
      "voice": "ko-KR-SunHiNeural",
      "gender": "female",
      "rate": "-3%",
      "pitch": "+0Hz",
      "file": "/audio/ko-v1/boss-8d9358c962b1a7fe.mp3",
