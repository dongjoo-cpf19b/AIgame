      ],
      "duration_seconds": 6.36,
      "bytes": 38160,
      "codec": "mp3",
      "sample_rate": 24000,
      "channels": 1
    },
    {
      "role": "senior",
      "text": "소방안전관리 폴더의 청사 소방계획서요. 피난계획이 거기 있어요.",
      "voice": "ko-KR-InJoonNeural",
      "gender": "male",
      "rate": "-3%",
      "pitch": "-4Hz",
      "file": "/audio/ko-v1/senior-f5fd98ea3df67390.mp3",
