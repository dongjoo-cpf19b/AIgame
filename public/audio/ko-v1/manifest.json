      "bytes": 20448,
      "codec": "mp3",
      "sample_rate": 24000,
      "channels": 1
    },
    {
      "role": "boss",
      "text": "작년에는 어디랑 같이 했어요?",
      "voice": "ko-KR-SunHiNeural",
      "gender": "female",
      "rate": "-3%",
      "pitch": "+0Hz",
