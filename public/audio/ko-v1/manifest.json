      "bytes": 43632,
      "codec": "mp3",
      "sample_rate": 24000,
      "channels": 1
    },
    {
      "role": "boss",
      "text": "별도 예산을 썼다고요? 계획서에 그렇게 되어 있었나요?",
      "voice": "ko-KR-SunHiNeural",
      "gender": "female",
      "rate": "-3%",
      "pitch": "+0Hz",
      "file": "/audio/ko-v1/boss-55178fee2b5ccfe3.mp3",
