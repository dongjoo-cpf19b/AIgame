        "nextHint"
      ],
      "duration_seconds": 10.344,
      "bytes": 62064,
      "codec": "mp3",
      "sample_rate": 24000,
      "channels": 1
    },
    {
      "role": "senior",
      "text": "그 정도면 충분해요. 팀장님께 차근차근 보고해봐요!",
      "voice": "ko-KR-InJoonNeural",
      "gender": "male",
      "rate": "-3%",
