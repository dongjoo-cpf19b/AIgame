      "sample_rate": 24000,
      "channels": 1
    },
    {
      "role": "boss",
      "text": "참, 제목에 ‘최종’ 붙었다고 그냥 믿지는 마세요. 근거까지 확인하고 보고해요.",
      "voice": "ko-KR-SunHiNeural",
      "gender": "female",
      "rate": "-3%",
      "pitch": "+0Hz",
      "file": "/audio/ko-v1/boss-cf044e0b80f2c455.mp3",
