      "codec": "mp3",
      "sample_rate": 24000,
      "channels": 1
    },
    {
      "role": "boss",
      "text": "거기였어요? 작년 협조기관 다시 확인해봐야 할 것 같은데.",
      "voice": "ko-KR-SunHiNeural",
      "gender": "female",
