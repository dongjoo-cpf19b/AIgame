        "questions.bad"
      ],
      "duration_seconds": 5.592,
      "bytes": 33552,
      "codec": "mp3",
      "sample_rate": 24000,
      "channels": 1
    },
    {
      "role": "boss",
      "text": "새로 오셨죠? 작년 합동소방훈련부터 파악해봐요. 파일은 공용폴더에 있을 거예요.",
      "voice": "ko-KR-SunHiNeural",
      "gender": "female",
      "rate": "-3%",
      "pitch": "+0Hz",
      "file": "/audio/ko-v1/boss-3858bcc918632c8d.mp3",
