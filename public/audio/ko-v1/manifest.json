      "sample_rate": 24000,
      "channels": 1
    },
    {
      "role": "firefighter",
      "text": "올해 합동소방훈련 일정 협의드리려고 전화드렸습니다.",
      "voice": "ko-KR-InJoonNeural",
      "gender": "male",
