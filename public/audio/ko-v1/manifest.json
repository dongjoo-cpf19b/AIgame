      "bytes": 52704,
      "codec": "mp3",
      "sample_rate": 24000,
      "channels": 1
    },
    {
      "role": "boss",
      "text": "야탑119안전센터. 맞아요. 올해 협의할 때도 기억해두세요.",
      "voice": "ko-KR-SunHiNeural",
      "gender": "female",
      "rate": "-3%",
