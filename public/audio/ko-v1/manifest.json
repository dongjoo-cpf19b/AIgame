      "codec": "mp3",
      "sample_rate": 24000,
      "channels": 1
    },
    {
      "role": "boss",
      "text": "우리가 소방관서하고 합동훈련하는 근거가 뭐예요?",
      "voice": "ko-KR-SunHiNeural",
      "gender": "female",
