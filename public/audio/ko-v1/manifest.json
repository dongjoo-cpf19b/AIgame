      "sample_rate": 24000,
      "channels": 1
    },
    {
      "role": "senior",
      "text": "청사도면 폴더 안의 소방 폴더를 찾아봐요. 피난동선도가 있을 거예요.",
      "voice": "ko-KR-InJoonNeural",
      "gender": "male",
      "rate": "-3%",
