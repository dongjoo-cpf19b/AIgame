      "bytes": 30960,
      "codec": "mp3",
      "sample_rate": 24000,
      "channels": 1
    },
    {
      "role": "firefighter",
      "text": "작년 자료 확인하셨다고요? 좋습니다. 이번에는 담당자님과 같이 준비하겠습니다.",
      "voice": "ko-KR-InJoonNeural",
      "gender": "male",
